# Copy to .env. Never commit .env.
EXA_API_KEY=
GEMINI_API_KEY=
INSTANTLY_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/outside/repo/service-account.json
OPENALEX_MAILTO=
# Free key from openalex.org: higher limits than anonymous requests (researchers, school lookups)
OPENALEX_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
ICYPEAS_API_KEY=
VERIFIER_API_KEY=
# smtp+ssl://user:password@smtp.example.com:465/alerts-to@example.com  (internal inbox, not a sending domain)
ALERT_SMTP_URL=
# Required by the SEC in the User-Agent of EDGAR requests (free founder source)
SEC_CONTACT_EMAIL=
# Free key from patentsview.org (free engineer source)
PATENTSVIEW_API_KEY=
